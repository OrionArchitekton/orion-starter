---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Orion Astro MPA Islands Starter"
  description="Zero-JS-by-default MPA starter with Tailwind v4 OKLCH tokens, Fontsource variable fonts, and native View Transitions."
  activeNav="overview"
>
  <section class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-7 space-y-5">
      <p
        class="text-xs uppercase tracking-[0.14em] text-[var(--color-orion-fg-muted)]"
        style="font-family: var(--font-orion-mono);"
      >
        GAP-FE-011 Static Editorial Default
      </p>
      <h1
        class="text-4xl font-bold leading-tight tracking-tight text-white sm:text-5xl"
        style="font-family: var(--font-orion-display);"
      >
        Zero-JS Editorial Pages with Selective Islands
      </h1>
      <p class="max-w-2xl text-base leading-relaxed text-[var(--color-orion-fg-muted)] sm:text-lg">
        Static hubs and /works/ microsites ship pure HTML and OKLCH CSS by default, using native browser View Transitions for smooth navigation and hydrating React islands only where interaction demands it.
      </p>
      <div class="flex flex-wrap items-center gap-3 pt-1">
        <a
          href="/playground"
          class="inline-flex min-h-[44px] items-center justify-center rounded bg-[var(--color-orion-accent)] px-5 py-2.5 text-sm font-semibold text-[var(--color-orion-accent-fg)] no-underline hover:bg-[var(--color-orion-accent-hover)]"
        >
          Open Interactive Island
        </a>
        <a
          href="/architecture"
          class="inline-flex min-h-[44px] items-center justify-center rounded border border-[var(--color-orion-border)] bg-[var(--color-orion-surface)] px-5 py-2.5 text-sm font-semibold text-[var(--color-orion-fg)] no-underline hover:bg-[var(--color-orion-surface-elevated)]"
        >
          Read Architecture
        </a>
      </div>
    </div>

    <aside class="lg:col-span-5 rounded-lg border border-[var(--color-orion-border)] bg-[var(--color-orion-surface)] p-6 space-y-4">
      <h2
        class="text-lg font-semibold text-white"
        style="font-family: var(--font-orion-display);"
      >
        Static Route Baseline
      </h2>
      <dl class="space-y-3 font-mono text-xs">
        <div class="flex items-center justify-between border-b border-[var(--color-orion-border)]/40 pb-2">
          <dt class="text-[var(--color-orion-fg-muted)]">Client JS Payload</dt>
          <dd class="m-0 font-semibold text-[var(--color-orion-accent)]">0 KB</dd>
        </div>
        <div class="flex items-center justify-between border-b border-[var(--color-orion-border)]/40 pb-2">
          <dt class="text-[var(--color-orion-fg-muted)]">MPA Transitions</dt>
          <dd class="m-0 font-semibold text-white">CSS @view-transition</dd>
        </div>
        <div class="flex items-center justify-between">
          <dt class="text-[var(--color-orion-fg-muted)]">Color Space</dt>
          <dd class="m-0 font-semibold text-white">Tailwind v4 OKLCH</dd>
        </div>
      </dl>
    </aside>
  </section>
</BaseLayout>
